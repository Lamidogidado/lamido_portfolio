# Copy to .env and fill in values from https://dashboard.emailjs.com/
# Template should use: {{from_name}}, {{email}}, {{message}}

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Legacy names (still supported): VITE_SERVICE, VITE_TEMPLATE_ID, VITE_PUBLIC_KEY
